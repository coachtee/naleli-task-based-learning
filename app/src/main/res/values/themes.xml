<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme: Compose owns all real theming (see ui/theme). This
         XML theme exists only for the manifest/window and the splash
         screen, per Android's Compose + core-splashscreen integration. -->
    <style name="Theme.Naleli" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface_white</item>
    </style>

    <!-- The OS-level splash (pre-Compose, API 31+ SplashScreen API) shows
         briefly during cold start using the square adaptive launcher icon —
         the system icon slot expects a compact, roughly-square graphic and
         will clip a tall mark. The full NIBS academic mark + institutional
         wordmark sequence (brief V1.5 §24) is shown by our own Compose
         SplashScreen composable immediately after, which has full layout
         control. -->
    <style name="Theme.Naleli.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/naleli_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Naleli</item>
    </style>
</resources>
