<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml — allowBackup="false" means neither cloud nor device-transfer backup is used. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
