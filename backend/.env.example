APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kcs_backend
DB_USERNAME=kcs_backend
DB_PASSWORD=

# The shared secret Fluent Forms signs its webhook body with. Generate with
# `php artisan kcs:secret` and paste the same value into the form's webhook
# integration on kcs.edu.za.
KCS_FLUENTFORM_SECRET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pay@ Go (YAPI merchant request-to-pay) --------------------------------
# Cash at a retail till against a reference number. Credentials come from the
# Pay@ merchant portal; without them the provider falls back to manual capture
# and nothing breaks.
PAYAT_BASE_URL=https://go.payat.co.za/yapi/v1
PAYAT_TOKEN_URL=https://go.payat.co.za/yapi/oauth/token
PAYAT_CLIENT_ID=
PAYAT_CLIENT_SECRET=
PAYAT_MERCHANT_DISPLAY_NAME="Katlehong Computer School"
PAYAT_ACCOUNT_PREFIX=9
PAYAT_DAYS_VALID=60

# --- Sending learner email -------------------------------------------------
# Brevo's HTTP API, because kcs.edu.za publishes
# `v=spf1 include:_spf.google.com ~all` — only Google may send as this domain,
# so anything relayed through the cPanel server fails SPF and lands in spam.
# Brevo is the sender that already passes for this domain: the website has
# been sending through it for months, and the backend now uses the same key.
#
# This is the v3 API key (xkeysib-…), not an SMTP key — Brevo's SMTP relay
# wants a different credential. The sender address must be a verified sender
# on the Brevo account or the API refuses the message.
#
# Leave BREVO_API_KEY empty and the backend simply does not send: it logs a
# warning and the registration still succeeds.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="admissions@kcs.edu.za"
MAIL_FROM_NAME="Katlehong Computer School"

# Where a learner reaches the workspace. Production only: the front controller
# lives in public_html/admin, so url() would put /admin/ in every learner URL
# and the app would refuse to install (manifest scope mismatch).
KCS_WORKSPACE_URL=

# Where the workspace calls the API. Production only, and for the same reason
# as KCS_WORKSPACE_URL: /workspace is an internal rewrite, so url() reports a
# root of "/" and would point every call at a 404.
KCS_API_URL=
